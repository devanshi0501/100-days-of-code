#include <stdio.h>

int main() {
    int n, i, pos, x;
    scanf("%d", &n);

    int a[n + 1];

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d %d", &pos, &x);

    for (i = n; i >= pos; i--) {
        a[i] = a[i - 1];
    }

    a[pos - 1] = x;

    for (i = 0; i <= n; i++) {
        printf("%d", a[i]);
        if (i < n) {
            printf(" ");
        }
    }

    return 0;
}
