#include <stdio.h>
#include <ctype.h>

int main(void)
{
    char c;

    printf("Enter the character");
    scanf("%c", &c);

    if (isupper(c))
        printf("Uppercase");

    else if (islower(c))
        printf("Lowercase");

    else if (isdigit(c))
        printf("Digit");

    else
        printf("Special Character");

    return 0;
}
