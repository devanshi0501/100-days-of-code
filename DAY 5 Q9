#include <stdio.h>
#include<math.h>

int main()
{
    float p,r,t,s,c;
    
    printf("Enter principal value");
    scanf("%f",&p);
    
    printf("Enter rate");
    scanf("%f",&r);
    
    printf("Enter time taken");
    scanf("%f",&t);
    
    s=(p*r*t)/100;
    c=p*pow((1+r/100.0),t)-p;
    
    printf("Simple Interest=%f\n",s);
    printf("Compound Interst=%f\n",c);
    
    return 0;
}

    
