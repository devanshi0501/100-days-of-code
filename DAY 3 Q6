#include <stdio.h>

int main()
{
    int a,b,c;
    
    printf("Enter first number");
    scanf("%d",&a);
    
    printf("Enter second number");
    scanf("%d",&b);
    
    c=b;
    b=a;
    a=c;
    
    printf("Swapped number of a=%d\n",a);
    printf("Swapped number of b=%d\n",b);
    
    return 0;
}
